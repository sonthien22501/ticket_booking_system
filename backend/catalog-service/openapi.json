{
  "openapi": "3.0.3",
  "info": {
    "title": "Catalog Service API",
    "version": "1.0.0",
    "description": "Event Catalog, Ticket Tiers, Search, Venue Floorplan, Pricing, Reviews, and External Mashup API."
  },
  "servers": [
    {
      "url": "/",
      "description": "API Gateway Base URL"
    }
  ],
  "paths": {
    "/api/events": {
      "get": {
        "summary": "List catalog events",
        "description": "Retrieve list of all active events with ticket tiers and venue info.",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Filter events by category (e.g. Music, Tech, Sports)",
            "schema": {
              "type": "string"
            },
            "example": "Music"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of events to return",
            "schema": {
              "type": "integer"
            },
            "example": 20
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Pagination offset",
            "schema": {
              "type": "integer"
            },
            "example": 0
          }
        ],
        "responses": {
          "200": {
            "description": "List of active events",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventListResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create new event",
        "description": "Admin endpoint to publish a new event.",
        "requestBody": {
          "required": true,
          "description": "Event creation payload",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEventRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Event created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or invalid request payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized administrator access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/search": {
      "get": {
        "summary": "Search events by title, city, or category",
        "description": "Full-text search query across events.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search keyword query",
            "schema": {
              "type": "string"
            },
            "example": "Rock Festival"
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "City where event is hosted",
            "schema": {
              "type": "string"
            },
            "example": "London"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category filter",
            "schema": {
              "type": "string"
            },
            "example": "Concert"
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventListResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{id}": {
      "get": {
        "summary": "Get event details by ID",
        "description": "Retrieve comprehensive event metadata including ticket tiers.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique event identifier",
            "schema": {
              "type": "string"
            },
            "example": "evt-101"
          }
        ],
        "responses": {
          "200": {
            "description": "Event details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "400": {
            "description": "Invalid event identifier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Event not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{id}/status": {
      "put": {
        "summary": "Update event lifecycle status (PUT)",
        "description": "Transition event state between DRAFT, PUBLISHED, ARCHIVED, or CANCELLED.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique event identifier",
            "schema": {
              "type": "string"
            },
            "example": "evt-101"
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Event status update payload",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventStatusUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event status updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "400": {
            "description": "Invalid status transition payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Event not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Partially update event lifecycle status (PATCH)",
        "description": "Patch event lifecycle state.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique event identifier",
            "schema": {
              "type": "string"
            },
            "example": "evt-101"
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Event status patch payload",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventStatusUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event status updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "400": {
            "description": "Invalid status transition payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Event not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{id}/pricing": {
      "get": {
        "summary": "Get dynamic surge pricing telemetry",
        "description": "Calculates surge multiplier and live pricing breakdown.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Event identifier",
            "schema": {
              "type": "string"
            },
            "example": "evt-101"
          }
        ],
        "responses": {
          "200": {
            "description": "Surge pricing information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventPricingResponse"
                }
              }
            }
          },
          "404": {
            "description": "Event not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{id}/floorplan": {
      "get": {
        "summary": "Get venue seating floorplan",
        "description": "Returns venue layout and seat coordinates.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Event identifier",
            "schema": {
              "type": "string"
            },
            "example": "evt-101"
          }
        ],
        "responses": {
          "200": {
            "description": "Floorplan layout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FloorplanResponse"
                }
              }
            }
          },
          "404": {
            "description": "Event not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{id}/mashup": {
      "get": {
        "summary": "Get event mashup intelligence (weather and audio preview)",
        "description": "Orchestrates catalog data with live Open-Meteo weather forecast and Apple iTunes track preview.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Event identifier",
            "schema": {
              "type": "string"
            },
            "example": "evt-101"
          }
        ],
        "responses": {
          "200": {
            "description": "Composed external mashup data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventMashupResponse"
                }
              }
            }
          },
          "404": {
            "description": "Event not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{id}/reviews": {
      "get": {
        "summary": "Get verified buyer reviews",
        "description": "List reviews and ratings submitted for this event.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Event identifier",
            "schema": {
              "type": "string"
            },
            "example": "evt-101"
          }
        ],
        "responses": {
          "200": {
            "description": "Review list retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventReviewsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Event not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Submit event review",
        "description": "Authenticated attendee submits rating and feedback.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Event identifier",
            "schema": {
              "type": "string"
            },
            "example": "evt-101"
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Review submission payload",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReviewRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Review submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Review"
                }
              }
            }
          },
          "400": {
            "description": "Invalid review parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings": {
      "post": {
        "summary": "Create ticket booking",
        "description": "Gateway route for booking confirmation.",
        "requestBody": {
          "required": true,
          "description": "Booking payload",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "400": {
            "description": "Invalid booking payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Seat conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/currencies/rates": {
      "get": {
        "summary": "Get currency exchange rates",
        "description": "Returns ECB live rates.",
        "responses": {
          "200": {
            "description": "Currency rates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrencyRatesResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/concierge/advise": {
      "post": {
        "summary": "Generate AI concierge advisory",
        "description": "Synthesizes event, weather, and budget tips.",
        "requestBody": {
          "required": true,
          "description": "Concierge advisory parameters",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConciergeAdviceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Advisory recommendation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConciergeAdviceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Event": {
        "type": "object",
        "required": [
          "id",
          "title",
          "category",
          "venueName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier of the event",
            "example": "evt-101"
          },
          "title": {
            "type": "string",
            "description": "Public headline title of the event",
            "example": "Coldplay Music of the Spheres"
          },
          "description": {
            "type": "string",
            "description": "Detailed event summary and itinerary",
            "example": "Experience Coldplay live in concert with special visual effects."
          },
          "category": {
            "type": "string",
            "description": "Classification category for the event",
            "example": "Music"
          },
          "venueName": {
            "type": "string",
            "description": "Name of the stadium or auditorium",
            "example": "Wembley Stadium"
          },
          "venueLocation": {
            "type": "string",
            "description": "Geographical address and host city",
            "example": "London, UK"
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "description": "ISO-8601 start timestamp",
            "example": "2026-08-15T19:00:00Z"
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "description": "ISO-8601 conclusion timestamp",
            "example": "2026-08-15T22:30:00Z"
          },
          "status": {
            "type": "string",
            "description": "Current lifecycle status (DRAFT, PUBLISHED, ARCHIVED, CANCELLED)",
            "example": "PUBLISHED"
          },
          "imageUrl": {
            "type": "string",
            "description": "Poster banner image URL",
            "example": "https://images.unsplash.com/photo-1470225620780-dba8ba36b745"
          },
          "tiers": {
            "type": "array",
            "description": "Associated seating and pricing tiers",
            "items": {
              "$ref": "#/components/schemas/EventTier"
            },
            "example": [
              {
                "tierId": "tier-vip",
                "name": "VIP Lounge",
                "price": 250.0
              }
            ]
          }
        }
      },
      "EventTier": {
        "type": "object",
        "required": [
          "tierId",
          "name",
          "price"
        ],
        "properties": {
          "tierId": {
            "type": "string",
            "description": "Unique identifier of the ticket tier",
            "example": "tier-vip"
          },
          "eventId": {
            "type": "string",
            "description": "Referenced parent event identifier",
            "example": "evt-101"
          },
          "name": {
            "type": "string",
            "description": "Tier display label",
            "example": "VIP Front Row"
          },
          "price": {
            "type": "number",
            "format": "double",
            "description": "Base unit ticket price in EUR",
            "example": 150.0
          },
          "capacity": {
            "type": "integer",
            "description": "Total seat allocation in this tier",
            "example": 100
          },
          "available": {
            "type": "integer",
            "description": "Number of unsold available seats",
            "example": 42
          },
          "availableSeats": {
            "type": "integer",
            "description": "Alternative alias for remaining seats",
            "example": 42
          },
          "description": {
            "type": "string",
            "description": "Tier perks and amenities description",
            "example": "Includes priority entrance and complimentary beverage."
          }
        }
      },
      "EventListResponse": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "description": "Collection of matching event objects",
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "example": [
              {
                "id": "evt-101",
                "title": "Coldplay Tour"
              }
            ]
          },
          "total": {
            "type": "integer",
            "description": "Total number of events matching query",
            "example": 1
          }
        }
      },
      "CreateEventRequest": {
        "type": "object",
        "required": [
          "title",
          "category",
          "venueName",
          "venueLocation",
          "startTime"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Optional client-specified event identifier",
            "example": "evt-101"
          },
          "title": {
            "type": "string",
            "description": "Title of the new event",
            "example": "Glastonbury Summer Fest"
          },
          "description": {
            "type": "string",
            "description": "Comprehensive event description",
            "example": "Three-day music and arts festival."
          },
          "category": {
            "type": "string",
            "description": "Event genre or category",
            "example": "Festival"
          },
          "venueName": {
            "type": "string",
            "description": "Host venue name",
            "example": "Worthy Farm"
          },
          "venueLocation": {
            "type": "string",
            "description": "City and country of venue",
            "example": "Pilton, Somerset, UK"
          },
          "startTime": {
            "type": "string",
            "description": "Scheduled start time",
            "example": "2026-06-24T12:00:00Z"
          },
          "endTime": {
            "type": "string",
            "description": "Scheduled finish time",
            "example": "2026-06-28T23:59:59Z"
          },
          "imageUrl": {
            "type": "string",
            "description": "Public URL for event promotional banner",
            "example": "https://images.unsplash.com/photo-1514525253161-7a46d19cd819"
          },
          "totalCapacity": {
            "type": "integer",
            "description": "Total audience capacity across all tiers",
            "example": 200000
          }
        }
      },
      "EventStatusUpdateRequest": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
